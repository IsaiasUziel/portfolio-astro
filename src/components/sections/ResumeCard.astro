---
import type { ExperienceEntry, SkillsEntry } from '../../lib/content/types';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  experience: ExperienceEntry[];
  skills: SkillsEntry;
}

const { locale, title, experience, skills } = Astro.props;
const fullResumeUrl = locale === 'es' ? 'https://resume.icordero.dev/resume' : 'https://resume.icordero.dev/en/resume';
const ctaLabel = locale === 'es' ? 'Ver currículum completo' : 'View full resume';
const ctaHelper = locale === 'es'
  ? 'Versión detallada y exportable en PDF.'
  : 'Detailed version with PDF export.';
---

<article class="card" id="resume">
  <div class="mb-8">
    <h2 class="text-2xl font-semibold text-text-primary">{title}</h2>
    <div class="mt-[1.0625rem] h-[0.3125rem] w-10 rounded-lg" style="background: var(--color-brand-gradient)"></div>
  </div>

  <!-- Experience section -->
  <section>
    <!-- Section header — icon box with brand border + vertical line extending below -->
    <div class="mb-2 flex items-center gap-4">
      <div class="section-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-brand-soft">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-text-primary">
        {locale === 'es' ? 'Experiencia' : 'Experience'}
      </h3>
    </div>

    <!-- Timeline — border-l is the vertical connecting line -->
    <div class="ml-5 border-l border-brand-soft/25 pl-4.5">
      <ol class="space-y-7 py-3">
        {
          experience.map((entry) => (
            <li class="relative">
              <!-- Dot positioned ON the border-l line -->
              <span
                class="absolute -left-6.25 top-0.5 h-3 w-3 rounded-full bg-brand-soft ring-[3px] ring-surface-elevated"
                aria-hidden="true"
              />
              <div>
                <p class="text-sm font-medium text-brand-soft">
                  {entry.data.start} — {entry.data.end ?? (locale === 'es' ? 'Actualidad' : 'Present')}
                </p>
                <h4 class="mt-0.5 text-base font-semibold text-text-primary lg:text-lg">
                  {entry.data.role}
                  <span class="font-normal text-text-muted"> · {entry.data.company}</span>
                </h4>
                <p class="mt-0.5 text-xs text-text-muted">{entry.data.location}</p>
                <ul class="mt-3 space-y-1.5 text-sm text-text-secondary">
                  {entry.data.bullets.map((bullet) => (
                    <li class="flex gap-2 before:mt-[0.45em] before:block before:h-1 before:w-1 before:shrink-0 before:rounded-full before:bg-brand-soft/50">
                      {bullet}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Skills section -->
  <section class="mt-8 border-t border-border-soft pt-6">
    <div class="mb-5 flex items-center gap-4">
      <div class="section-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-brand-soft">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-text-primary">
        {locale === 'es' ? 'Habilidades' : 'Skills'}
      </h3>
    </div>

    <div class="space-y-4">
      {
        skills.data.categories.map((category) => (
          <div>
            <p class="text-sm font-medium text-brand-soft">{category.title}</p>
            <p class="mt-1 text-sm text-text-secondary">{category.items.join(' · ')}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="mt-8 border-t border-border-soft pt-6">
    <a
      href={fullResumeUrl}
      target="_blank"
      rel="noreferrer"
      class="resume-cta group inline-flex items-center gap-3 rounded-2xl px-4 py-3 text-sm text-text-primary transition-transform duration-200 hover:-translate-y-0.5"
    >
      <span class="resume-cta__icon flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 3h7v7" />
          <path d="M10 14 21 3" />
          <path d="M21 14v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        </svg>
      </span>

      <span>
        <span class="block font-medium text-brand-soft">{ctaLabel}</span>
        <span class="mt-0.5 block text-xs text-text-muted">{ctaHelper}</span>
      </span>
    </a>
  </div>
</article>

<style>
  /* Section icon box — bordered, no fill, matching vcard4 reference */
  .section-icon {
    border: 1px solid rgba(255, 188, 94, 0.35);
    background: transparent;
  }

  .resume-cta {
    border: 1px solid rgba(255, 188, 94, 0.22);
    background: rgba(255, 255, 255, 0.02);
  }

  .resume-cta:hover {
    border-color: rgba(255, 188, 94, 0.38);
    background: rgba(255, 255, 255, 0.04);
  }

  .resume-cta__icon {
    border: 1px solid rgba(255, 188, 94, 0.28);
    color: rgb(255 188 94);
  }
</style>
