---
import ContactCard from "../sections/ContactCard.astro";
import AboutCard from "../sections/AboutCard.astro";
import ProjectsCard from "../sections/ProjectsCard.astro";
import TestimonialsCard from "../sections/TestimonialsCard.astro";
import IdentitySidebar from "../shell/IdentitySidebar.astro";
import Nav from "../shell/Nav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getHomeContent, getTestimonials } from "../../lib/content/loaders";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
  currentPath: string;
  canonicalPath: string;
}

const { locale, currentPath, canonicalPath } = Astro.props as Props;
const [home, testimonials] = await Promise.all([
  getHomeContent(locale),
  getTestimonials(),
]);

const copy =
  locale === "es"
    ? {
        pageHeading: "Inicio",
        metaTitle: "Isaías Cordero · Senior Software Engineer",
        description:
          "Senior Software Engineer y líder técnico hands-on: arquitectura web, equipos y entrega de soluciones mantenibles en producción.",
        eyebrow: "Senior Software Engineer · Frontend y liderazgo técnico",
        heroTitle:
          "Lidero la arquitectura y la entrega de productos web sin perder claridad técnica.",
        heroSupport:
          "Trabajo entre negocio, diseño y desarrollo para convertir requerimientos complejos en soluciones mantenibles y listas para producción. Combino liderazgo de equipos con ejecución hands-on en React, Next.js y plataformas WordPress/Bedrock.",
        proof:
          "Experiencia profesional desde 2017 · Liderazgo técnico hands-on · Entrega desde la propuesta hasta producción",
        casesCta: "Ver casos seleccionados",
        resumeCta: "Ver currículum",
        contactCta: "Contactar por email",
        selectedCasesTitle: "Casos seleccionados",
        aboutTitle: "Cómo trabajo",
        aboutParagraphs: [
          "Conecto objetivos de negocio y diseño con decisiones técnicas claras, sostenibles y viables para producción.",
          "Acompaño a los equipos en arquitectura, criterios compartidos y ejecución, manteniéndome cerca del código y de la entrega.",
        ],
        testimonialExcerpt:
          "Una contraparte tecnológica sólida, con una mirada técnica clara frente a requerimientos complejos.",
        testimonialAttribution: "Waldo López, director de proyectos",
        testimonialLink: "Leer recomendaciones",
        contactTitle: "Contacto",
        testimonialsTitle: "Recomendaciones",
      }
    : {
        pageHeading: "Home",
        metaTitle: "Isaías Cordero · Senior Software Engineer",
        description:
          "Senior Software Engineer and hands-on technical leader focused on web architecture, team guidance, and maintainable production delivery.",
        eyebrow: "Senior Software Engineer · Frontend and technical leadership",
        heroTitle:
          "I lead web architecture and product delivery while staying hands-on with the code.",
        heroSupport:
          "I work across business, design, and engineering to turn complex requirements into maintainable, production-ready solutions. I combine team leadership with hands-on delivery across React, Next.js, and WordPress/Bedrock platforms.",
        proof:
          "Professional experience since 2017 · Hands-on technical leadership · Delivery from proposal to production",
        casesCta: "View selected cases",
        resumeCta: "View resume",
        contactCta: "Contact by email",
        selectedCasesTitle: "Selected case studies",
        aboutTitle: "How I work",
        aboutParagraphs: [
          "I connect business and design goals with clear technical decisions that are sustainable and ready for production.",
          "I guide teams through architecture, shared standards, and execution while staying close to the code and delivery.",
        ],
        testimonialExcerpt:
          "A trusted technology counterpart who brings technical clarity to complex requirements.",
        testimonialAttribution: "Waldo López, project director",
        testimonialLink: "Read recommendations",
        contactTitle: "Contact",
        testimonialsTitle: "Recommendations",
      };

const homeHref = locale === "es" ? "/" : "/en";
const proofItems = copy.proof.split(" · ");
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={copy.metaTitle}
  description={copy.description}
  canonicalPath={canonicalPath}
  pageHeading={copy.pageHeading}
>
  <Fragment slot="sidebar">
    <IdentitySidebar
      locale={locale}
      name={home.profile.data.name}
      headline={home.profile.data.headline}
      location={home.profile.data.location}
      email={home.contact.data.email}
      linkedin={home.contact.data.linkedin}
    />
  </Fragment>

  <Fragment slot="panel-tabs">
    <Nav locale={locale} currentPath={currentPath} />
  </Fragment>

  <div class="divide-y divide-border-soft">
    <section
      class="px-5 pb-10 pt-9 lg:px-7 lg:pb-12 lg:pt-24"
      aria-labelledby="page-title"
    >
      <p
        class="max-w-[30rem] text-xs font-semibold uppercase tracking-[0.18em] text-brand-soft"
      >
        {copy.eyebrow}
      </p>
      <h1
        id="page-title"
        class="mt-5 max-w-[34rem] text-3xl font-semibold leading-[1.12] text-text-primary sm:text-4xl lg:text-[2.85rem]"
      >
        {copy.heroTitle}
      </h1>
      <p
        class="mt-6 max-w-[38rem] text-base leading-relaxed text-text-secondary"
      >
        {copy.heroSupport}
      </p>

      <ul
        class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5 sm:gap-y-2"
        aria-label={locale === "es" ? "Prueba profesional" : "Professional proof"}
      >
        {
          proofItems.map((item) => (
            <li class="flex items-center gap-2.5 text-sm font-medium text-text-muted">
              <span
                class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-soft"
                aria-hidden="true"
              />
              {item}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          class="rounded-pill bg-brand-strong px-5 py-2.5 text-sm font-semibold text-text-inverse transition-[background-color,transform] hover:bg-brand-soft motion-safe:active:scale-[0.98]"
          href="#projects"
        >
          {copy.casesCta}
        </a>
        <a
          class="rounded-pill border border-border-strong px-5 py-2.5 text-sm font-semibold text-text-primary transition-[color,border-color,transform] hover:border-brand-soft hover:text-brand-soft motion-safe:active:scale-[0.98]"
          href={`mailto:${home.contact.data.email}`}
        >
          {copy.contactCta}
        </a>
        <a
          class="px-2 py-2.5 text-sm font-medium text-brand-soft hover:text-brand-strong"
          href={`/${locale}/resume`}
        >
          {copy.resumeCta}
        </a>
      </div>

      <figure class="mt-9 max-w-[38rem] border-l-2 border-brand-soft/60 pl-4">
        <blockquote class="text-sm leading-relaxed text-text-secondary">
          &ldquo;{copy.testimonialExcerpt}&rdquo;
        </blockquote>
        <figcaption class="mt-2 text-xs text-text-muted">
          {copy.testimonialAttribution}
          <span aria-hidden="true"> · </span>
          <a
            class="text-brand-soft hover:text-brand-strong"
            href={`${homeHref}#testimonials`}
          >
            {copy.testimonialLink}
          </a>
        </figcaption>
      </figure>
    </section>
    <ProjectsCard
      classes="px-5 lg:px-7"
      locale={locale}
      title={copy.selectedCasesTitle}
      projects={home.projects}
    />
    <AboutCard
      classes="px-5 lg:px-7"
      title={copy.aboutTitle}
      paragraphs={copy.aboutParagraphs}
    />
    <TestimonialsCard
      locale={locale}
      title={copy.testimonialsTitle}
      testimonials={testimonials}
    />
    <ContactCard
      classes="px-5 lg:px-7 mb-5 lg:mb-7"
      locale={locale}
      title={copy.contactTitle}
      contact={home.contact}
    />
  </div>
</BaseLayout>
