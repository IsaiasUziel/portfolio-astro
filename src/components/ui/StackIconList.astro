---
interface Props {
  stack: string[];
  ariaLabel?: string;
}

type IconTone = 'orange' | 'blue' | 'cyan' | 'green' | 'violet' | 'rose' | 'neutral';

interface StackIconMeta {
  shortLabel: string;
  tone: IconTone;
  variant?: 'atom' | 'bolt' | 'waves' | 'book' | 'cube' | 'shield' | 'code' | 'cloud' | 'map' | 'wordpress';
}

const { stack, ariaLabel = 'Project technology stack' } = Astro.props;

const iconRegistry: Record<string, StackIconMeta> = {
  astro: { shortLabel: 'A', tone: 'orange', variant: 'bolt' },
  typescript: { shortLabel: 'TS', tone: 'blue', variant: 'code' },
  'tailwind css': { shortLabel: 'TW', tone: 'cyan', variant: 'waves' },
  starlight: { shortLabel: 'SL', tone: 'violet', variant: 'book' },
  'spec-driven development': { shortLabel: 'SDD', tone: 'green', variant: 'book' },
  mcp: { shortLabel: 'MCP', tone: 'neutral', variant: 'cube' },
  opencode: { shortLabel: 'OC', tone: 'orange', variant: 'code' },
  react: { shortLabel: 'R', tone: 'cyan', variant: 'atom' },
  storybook: { shortLabel: 'SB', tone: 'rose', variant: 'book' },
  'wordpress bedrock': { shortLabel: 'WP', tone: 'blue', variant: 'wordpress' },
  vite: { shortLabel: 'V', tone: 'violet', variant: 'bolt' },
  docker: { shortLabel: 'D', tone: 'blue', variant: 'cube' },
  php: { shortLabel: 'PHP', tone: 'violet', variant: 'code' },
  html: { shortLabel: 'H', tone: 'orange', variant: 'code' },
  javascript: { shortLabel: 'JS', tone: 'orange', variant: 'code' },
  'oracle object storage': { shortLabel: 'OO', tone: 'rose', variant: 'cloud' },
  openlayers: { shortLabel: 'OL', tone: 'green', variant: 'map' },
  laravel: { shortLabel: 'L', tone: 'rose', variant: 'code' },
  jwt: { shortLabel: 'JWT', tone: 'green', variant: 'shield' },
  recaptcha: { shortLabel: 'RC', tone: 'blue', variant: 'shield' },
};

const normalizeTechnology = (technology: string) => technology.trim().toLowerCase();

const createFallbackIcon = (technology: string): StackIconMeta => ({
  shortLabel: technology
    .split(/[\s/-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase(),
  tone: 'neutral',
  variant: 'cube',
});

const getIconMeta = (technology: string) => iconRegistry[normalizeTechnology(technology)] ?? createFallbackIcon(technology);

const createTooltipId = (technology: string, index: number) =>
  `stack-tooltip-${index}-${normalizeTechnology(technology).replace(/[^a-z0-9]+/g, '-')}`;
---

<ul class="stack-icons" aria-label={ariaLabel}>
  {
    stack.map((technology, index) => {
      const meta = getIconMeta(technology);
      const tooltipId = createTooltipId(technology, index);

      return (
        <li class="stack-icons__item">
          <span class:list={["stack-icons__badge", `stack-icons__badge--${meta.tone}`]} tabindex="0" aria-label={technology} aria-describedby={tooltipId}>
            <svg viewBox="0 0 32 32" role="img" aria-hidden="true" focusable="false">
              {meta.variant === 'atom' && (
                <>
                  <ellipse cx="16" cy="16" rx="11" ry="4.3" />
                  <ellipse cx="16" cy="16" rx="11" ry="4.3" transform="rotate(60 16 16)" />
                  <ellipse cx="16" cy="16" rx="11" ry="4.3" transform="rotate(120 16 16)" />
                  <circle cx="16" cy="16" r="2.2" fill="currentColor" />
                </>
              )}
              {meta.variant === 'bolt' && <path d="M18.2 3.8 7.6 18.1h7.5l-1.3 10.1 10.6-14.4h-7.5l1.3-10Z" />}
              {meta.variant === 'waves' && <path d="M4 19.4c3.6 0 3.6-2.8 7.2-2.8s3.6 2.8 7.2 2.8 3.6-2.8 7.6-2.8M4 13.1c3.6 0 3.6-2.8 7.2-2.8s3.6 2.8 7.2 2.8 3.6-2.8 7.6-2.8" />}
              {meta.variant === 'book' && <path d="M7 6.5h9.5A4.5 4.5 0 0 1 21 11v14.5h-9.5A4.5 4.5 0 0 1 7 21V6.5Zm14 0h4v19h-4" />}
              {meta.variant === 'cube' && <path d="m16 4 10 5.6v12.8L16 28 6 22.4V9.6L16 4Zm0 11.8 10-6.2M16 15.8 6 9.6M16 15.8V28" />}
              {meta.variant === 'shield' && <path d="M16 4.8 25 8v7.1c0 5.7-3.7 10.8-9 12.5-5.3-1.7-9-6.8-9-12.5V8l9-3.2Zm-4 11.4 2.7 2.7 5.8-6" />}
              {meta.variant === 'code' && <path d="m12.2 10-5.4 6 5.4 6M19.8 10l5.4 6-5.4 6M17.8 7.5l-3.6 17" />}
              {meta.variant === 'cloud' && <path d="M10.2 23.5h12a5 5 0 0 0 .6-9.9A7.1 7.1 0 0 0 9.1 12 5.8 5.8 0 0 0 10.2 23.5Z" />}
              {meta.variant === 'map' && <path d="m5 8 7-3 8 3 7-3v19l-7 3-8-3-7 3V8Zm7-3v19m8-16v19" />}
              {meta.variant === 'wordpress' && <path d="M16 4.8a11.2 11.2 0 1 0 0 22.4 11.2 11.2 0 0 0 0-22.4Zm-7.6 7.1 5.1 12.2m3.5-8.2 3.5 8.2m2.9-12.2-4.5 12.2m-9.6-12.2h13.4" />}
            </svg>
            <span class="stack-icons__short" aria-hidden="true">{meta.shortLabel}</span>
            <span id={tooltipId} class="stack-icons__tooltip" role="tooltip">{technology}</span>
          </span>
        </li>
      );
    })
  }
</ul>

<style>
  .stack-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .stack-icons__item {
    position: relative;
  }

  .stack-icons__badge {
    position: relative;
    display: inline-flex;
    width: 2.45rem;
    height: 2.45rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    color: var(--stack-icon-color, var(--color-brand-soft));
    cursor: help;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .stack-icons__badge:hover,
  .stack-icons__badge:focus-visible {
    border-color: color-mix(in srgb, var(--stack-icon-color, var(--color-brand-soft)) 65%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--stack-icon-color, var(--color-brand-soft)) 18%, transparent);
    outline: none;
    transform: translateY(-0.12rem);
  }

  .stack-icons__badge svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .stack-icons__short {
    position: absolute;
    right: 0.32rem;
    bottom: 0.24rem;
    color: var(--color-text-primary);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .stack-icons__tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.55rem);
    z-index: 10;
    width: max-content;
    max-width: 12rem;
    padding: 0.38rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.55rem;
    background: rgba(18, 20, 28, 0.96);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.28);
    color: var(--color-text-primary);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.25rem) scale(0.96);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .stack-icons__tooltip::after {
    position: absolute;
    left: 50%;
    top: 100%;
    width: 0.55rem;
    height: 0.55rem;
    background: inherit;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    content: '';
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .stack-icons__badge:hover .stack-icons__tooltip,
  .stack-icons__badge:focus-visible .stack-icons__tooltip {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }

  .stack-icons__badge--orange { --stack-icon-color: #ffbc5e; }
  .stack-icons__badge--blue { --stack-icon-color: #78a5ff; }
  .stack-icons__badge--cyan { --stack-icon-color: #5ee7ff; }
  .stack-icons__badge--green { --stack-icon-color: #94e2a8; }
  .stack-icons__badge--violet { --stack-icon-color: #b7a7ff; }
  .stack-icons__badge--rose { --stack-icon-color: #ff8fa6; }
  .stack-icons__badge--neutral { --stack-icon-color: var(--color-text-secondary); }
</style>
