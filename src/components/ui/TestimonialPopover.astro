---
import type { Locale } from "../../lib/i18n";

interface Props {
  id: string;
  locale: Locale;
  name: string;
  role: string;
  linkedin: string;
  date: string;
  quote: string;
  relation: string;
  initials: string;
  gradient: string;
}

const {
  id,
  locale,
  name,
  role,
  linkedin,
  date,
  quote,
  relation,
  initials,
  gradient,
} = Astro.props;
const titleId = `${id}-title`;
const linkedinHref = String(linkedin);
---

<div
  id={id}
  class="testimonial-modal fixed inset-0 z-[200] hidden items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby={titleId}
  data-testimonial-modal
>
  <div
    class="testimonial-modal-card relative w-full max-w-xl rounded-2xl border border-border-soft bg-surface-elevated p-8"
    data-testimonial-modal-card
  >
    <button
      type="button"
      class="testimonial-modal-close absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full border border-border-soft text-text-muted transition-colors hover:border-brand-soft/40 hover:text-text-primary"
      aria-label={locale === "es" ? "Cerrar" : "Close"}
      data-testimonial-modal-close
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="mb-6 flex items-start gap-5">
      <div
        class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl text-lg font-bold text-white"
        style={`background: ${gradient}`}
        aria-hidden="true"
      >
        {initials}
      </div>
      <div>
        <h3 id={titleId} class="text-lg font-bold text-text-primary">
          <a
            href={linkedinHref}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={`${name} · ${locale === "es" ? "Perfil de LinkedIn" : "LinkedIn profile"}`}
            class="inline-flex items-center gap-1.5 transition-colors hover:text-brand-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-soft/70 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
          >
            <span>{name}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
              ></path>
              <polyline points="15,3 21,3 21,9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </h3>
        <p class="mt-0.5 text-xs text-text-muted">{role}</p>
        <p class="mt-2 text-sm text-brand-soft">{date}</p>
      </div>
    </div>

    <div class="relative">
      <div
        class="absolute right-0 top-0 mb-3 -translate-y-2/5 text-[8rem] font-bold leading-none text-brand-soft/20 opacity-20"
        aria-hidden="true"
      >
        ❝
      </div>

      <blockquote class="text-sm leading-relaxed text-text-secondary">
        {quote}
      </blockquote>
    </div>

    <p class="mt-5 text-xs text-text-muted">{relation}</p>
  </div>
</div>
