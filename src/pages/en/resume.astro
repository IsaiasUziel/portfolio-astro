---
import ResumeCard from '../../components/sections/ResumeCard.astro';
import IdentitySidebar from '../../components/shell/IdentitySidebar.astro';
import Nav from '../../components/shell/Nav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContact, getResumeContent } from '../../lib/content/loaders';

const locale = 'en' as const;
const content = await getResumeContent(locale);
const contact = await getContact(locale);
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title="Career · Isaías Cordero"
  description="Professional timeline, skills, and frontend engineering track record."
  canonicalPath={currentPath}
  pageHeading="Career"
>
  <Fragment slot="sidebar">
    <IdentitySidebar
      locale={locale}
      name={content.profile.data.name}
      headline={content.profile.data.headline}
      location={content.profile.data.location}
      email={contact.data.email}
      linkedin={contact.data.linkedin}
    />
  </Fragment>

  <Fragment slot="panel-tabs">
    <Nav locale={locale} currentPath={currentPath} />
  </Fragment>

  <ResumeCard locale={locale} title="Career timeline" experience={content.experience} skills={content.skills} />
</BaseLayout>
