---
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

import { getTranslatedPath, toDefaultLocaleRoot } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import LanguageSwitcher from "../components/ui/LanguageSwitcher.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
  currentPath: string;
  title: string;
  description: string;
  canonicalPath: string;
  pageHeading: string;
}

const { locale, currentPath, title, description, canonicalPath, pageHeading } =
  Astro.props;
const hasTabs = Astro.slots.has("panel-tabs");
const canonical = new URL(canonicalPath, Astro.site);
const spanishPath = toDefaultLocaleRoot(
  getTranslatedPath(currentPath, locale, "es"),
  "es",
);
const englishPath = getTranslatedPath(currentPath, locale, "en");
const spanishHref = new URL(spanishPath, Astro.site);
const englishHref = new URL(englishPath, Astro.site);
const ogImage = new URL("/og/default-og.svg", Astro.site);
const socialDescription = description;
const socialSiteName = 'iCordero';
const socialImageAlt = locale === 'es'
  ? 'Vista previa del portfolio de Isaías Cordero'
  : 'Preview of Isaías Cordero portfolio';
const isHomePage = ["/en", "/"].includes(currentPath);
---

<html lang={locale} class="bg-surface-canvas text-text-primary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#0c0b0b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={spanishHref} />
    <link rel="alternate" hreflang="en" href={englishHref} />
    <link rel="alternate" hreflang="x-default" href={spanishHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={socialSiteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <ClientRouter />
  </head>
  <body class:list={[hasTabs && "pb-20 lg:pb-0"]}>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:bg-brand-strong focus:px-4 focus:py-2 focus:text-text-inverse"
    >
      {locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>

    <div class="mx-auto max-w-272 px-4 pt-4 lg:px-6">
      <div class="flex justify-end">
        <LanguageSwitcher locale={locale} currentPath={currentPath} />
      </div>
    </div>

    <div class="shell-grid">
      <header>
        <slot name="sidebar" />
      </header>
      <main
        id="main-content"
        transition:name="main-panel"
        transition:animate="slide"
        class="panel relative min-h-[68vh] overflow-hidden"
        aria-labelledby="page-title"
      >
        <h1 id="page-title" class="sr-only">{pageHeading}</h1>
        {
          hasTabs && (
            <div class="fixed lg:bg-secondary inset-x-0 bottom-0 z-[var(--z-nav)] flex h-16 items-center justify-center rounded-t-[1.25rem] border-t border-border-soft bg-[#292c3d] px-4 shadow-[0_-12px_34px_rgba(0,0,0,0.38)] backdrop-blur-md lg:absolute lg:inset-x-auto lg:bottom-auto lg:right-0 lg:top-0 lg:h-16 lg:rounded-bl-[20px] lg:rounded-tr-[var(--radius-panel)] lg:rounded-tl-none lg:border-b lg:border-l lg:border-r-0 lg:border-t-0 lg:px-9.5 lg:shadow-none lg:backdrop-blur-none">
              <slot name="panel-tabs" />
            </div>
          )
        }
        <div class={isHomePage ? undefined : 'p-5 lg:p-7'}>
          <slot />
        </div>
      </main>
    </div>
    <Analytics />
  </body>
</html>
